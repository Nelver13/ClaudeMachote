.motor/motor.json

# Entorno
.env
.env.local
.env.*.local
*.log
.DS_Store
Thumbs.db

# Entorno virtual
.venv/
venv/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Django
db.sqlite3
media/
staticfiles/

# React + Vite
node_modules/
dist/
.vite/

